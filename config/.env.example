# =============================================================================
# FRESHMAN BOT ARENA (OTTV2 ICPC) - PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================

# 1. Server Configuration
ENVIRONMENT=production
DEBUG=false
HOST=0.0.0.0
PORT=8000
WORKERS=4

# 2. Security & Secrets
SECRET_KEY=change-this-to-a-very-secure-random-secret-key-in-production
ALLOWED_ORIGINS=https://creating-olive-patrick-customs.trycloudflare.com,https://yourdomain.com,http://localhost:8000

# 3. Data & Persistence
DATA_DIR=data
DB_SYNC_DEBOUNCE_SEC=1.0
MAX_SUBMISSIONS_PER_MATCH=200

# 4. In-Memory Caching (SingleFlight & TTL)
CACHE_ENABLED=true
CACHE_DEFAULT_TTL_SEC=2
GZIP_MIN_SIZE_BYTES=1024

# 5. In-Memory Rate Limiting (DDoS & Spam Protection)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_SUBMIT_PER_MINUTE=60

# 6. Sandbox Isolation Limits
SANDBOX_TIMEOUT_SEC=0.5
SANDBOX_MAX_WORKERS=8

# 7. Cloudflare Tunnel (Optional)
CLOUDFLARE_TUNNEL_NAME=ottv2-arena-tunnel
CLOUDFLARE_TUNNEL_ID=
