# Copy OUTSIDE the repository to /etc/arena/judge.env; chmod 600.
# Private IP of this worker (not its public IPv4).
JUDGE_PRIVATE_IP=10.0.1.10
WORKER_TOKEN=replace-with-a-long-random-secret-shared-with-gateway
WORKER_CAPACITY=2
# Identical Git commit/image on every judge during an event.
ARENA_RELEASE=release-commit
