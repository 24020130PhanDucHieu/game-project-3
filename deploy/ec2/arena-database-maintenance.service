[Unit]
Description=Arena expired cache and token cleanup
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=arena
EnvironmentFile=/etc/arena/backend.env
ExecStart=/usr/bin/python3 /opt/arena/app/scripts/database_maintenance.py --apply
TimeoutStartSec=40
Nice=10
CPUQuota=25%
MemoryMax=96M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
