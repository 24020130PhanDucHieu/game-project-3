[Unit]
Description=Arena isolated bot execution worker
Wants=network-online.target
After=network-online.target

[Service]
User=arena-worker
Group=arena-worker
WorkingDirectory=/opt/arena/app/bot-runner
Environment=ENVIRONMENT=production
Environment=PYTHONIOENCODING=utf-8
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/arena/venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port 8001
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Worker accepts requests only on localhost and cannot reach the public network.
IPAddressDeny=any
IPAddressAllow=localhost
InaccessiblePaths=/etc/arena /var/lib/arena
ProtectProc=invisible
ReadWritePaths=/var/lib/arena-worker
UMask=0077
MemoryHigh=512M
MemoryMax=700M
TasksMax=128

[Install]
WantedBy=multi-user.target
