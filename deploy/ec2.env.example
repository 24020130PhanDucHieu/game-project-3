# Copy to .env.ec2 at the project root. Never commit the completed file.
# Keep the SAME values currently configured on Render.
DATABASE_URL=
ADMIN_PASSWORD=
SESSION_SECRET=
# Set to the EXISTING account encryption secret (previous SESSION_SECRET/admin
# fallback), not a new random value. Keep stable when changing admin/session keys.
# ACCOUNT_ENCRYPTION_KEY=
# Exact frontend origin, without a trailing slash, e.g. https://your-app.workers.dev
CORS_ORIGIN=https://arena.13.250.49.111.sslip.io,https://game-project-3.phanhieu06hungyen.workers.dev
# Optional: stateless workers on a private network; omitted = existing local worker.
# WORKER_URLS=http://10.0.0.10:8001/mutate-tournament,http://10.0.0.11:8001/mutate-tournament
# QUALIFIER_WORKERS=2
# VALIDATION_WORKERS=2
# WORKER_CONCURRENCY=1
# With two private judge VMs, set JUDGE_CONCURRENCY=2 below.
# WORKER_ATTEMPT_TIMEOUT_SECONDS=90
# WORKER_TOKEN=shared-secret-for-private-remote-workers
# WORKER_RELEASE=exact-git-commit-on-every-judge
# Shared cap for all judging calls; start at 1 on a small EC2 instance.
JUDGE_CONCURRENCY=1

# Gửi mã khôi phục mật khẩu qua email (Gmail + App password). Xem docs/EMAIL_SETUP.md
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# IP công khai của từng máy chấm (cùng thứ tự WORKER_URLS), chỉ để hiển thị trong Giám sát.
# WORKER_PUBLIC_HOSTS=13.250.49.111,13.212.114.254
# Bắt buộc tích ô "Tôi không phải robot" khi đội đăng nhập/đăng ký/quên mật khẩu.
# HUMAN_CHECK=1

# Trợ lý AI hỏi đáp luật (Claude). Không có khóa thì trợ lý tự ẩn, hệ thống vẫn chạy bình thường.
# Tạo khóa ở console.anthropic.com, chỉ đặt trong file này trên máy chủ, KHÔNG commit.
# ANTHROPIC_API_KEY=
# Mô hình (mặc định claude-haiku-5-5: nhanh, rẻ). Chỉ đổi khi đã thử bằng scripts/test_ai_assistant.py.
# AI_MODEL=claude-haiku-5-5
# Hạn mức mặc định, BTC chỉnh lại được ở Quản trị > Hỏi đáp > Trợ lý AI.
# AI_DAILY_PER_TEAM=30
# AI_DAILY_BUDGET=2000000
# Đặt 0 để tắt hẳn trợ lý dù có khóa.
# AI_ENABLED=1
